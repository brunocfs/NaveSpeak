# Copie este arquivo para ".env" na raiz do projeto e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# ---- Servidor ----
NODE_ENV=development
PORT=4000
# Origem exata a partir de onde o client (web/Electron) pode falar com a API.
# Em producao, aponte para o IP/host da VPN pelo qual os usuarios acessam o app.
CORS_ORIGIN=http://localhost:5173

# ---- Banco de dados ----
# O projeto suporta MySQL (config/db.mysql.js) e PostgreSQL (config/db.js).
# A conexão ativa é a do PostgreSQL (config/db.js). Para trocar de driver,
# ajuste os imports em server/src/db/*.repo.js e server/src/config/env.js.
# Use um usuario de aplicacao dedicado (NUNCA root/superuser) com senha forte.
# PostgreSQL (padrao): porta 5432. MySQL: porta 3306.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=navespeak
DB_USER=navespeak_app
DB_PASSWORD=troque-por-uma-senha-forte-unica

# ---- Autenticacao ----
# Gere segredos aleatorios longos, por exemplo: openssl rand -hex 64
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-longo-diferente
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# "true" somente quando o servidor estiver atras de HTTPS/WSS
COOKIE_SECURE=false

# ---- Cadastro (registro/invite-only) ----
# "true" = so e possivel criar conta com um convite valido (ver painel admin
# em /admin/invites). "false" = cadastro publico liberado.
INVITE_ONLY=false
# Origem usada para montar o link de convite (ex.: no email enviado).
# Vazio = usa CORS_ORIGIN. Em producao, aponte para a URL publica do app.
APP_BASE_URL=

# ---- SMTP (convite por email) ----
# Opcional: sem SMTP_HOST, o convite por email so fica disponivel pelo link
# (o servidor loga o link no console em vez de enviar).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- mediasoup (preenchido na Fase 3) ----
# IP atribuido pela VPN (ex.: RadminVPN) na maquina que hospeda o servidor.
# E o IP que os outros peers vao usar para estabelecer a conexao WebRTC.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# ---- Observabilidade (ver docs/observability.md) ----
SERVICE_NAME=navespeak-api
# Em deploy, use o git SHA/tag: SERVICE_VERSION=$(git rev-parse --short HEAD)
SERVICE_VERSION=local
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Só local (exige pino-pretty instalado). Proibido em produção.
LOG_PRETTY=false
# Chaves extras a mascarar (somadas às padrão, que não podem ser removidas).
LOG_REDACT_PATHS=password,token,accessToken,refreshToken,authorization,cookie,secret,apiKey
# Debug temporário: corpo (redigido) só sai com LOG_LEVEL=debug.
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_SLOW_REQUEST_MS=1000
LOG_SLOW_DB_QUERY_MS=500
LOG_SLOW_REDIS_COMMAND_MS=100
# Fração (0..1) dos logs http_request 2xx/3xx mantidos. Erros/lentos: sempre.
LOG_SAMPLE_RATE=1
# OpenTelemetry: exige instalar o SDK no servidor (docs/observability.md).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=navespeak-api
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
# Obrigatório para expor /metrics em produção (Bearer). Gere: openssl rand -hex 32
METRICS_TOKEN=
HEALTH_DETAILS_ENABLED=false
# Atrás do Nginx: 1. Sem proxy: false.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
