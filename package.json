{
  "name": "navespeak",
  "private": true,
  "version": "0.1.0",
  "description": "App de voz, texto e compartilhamento de tela para um grupo fechado de usuarios via VPN.",
  "workspaces": [
    "server",
    "client",
    "electron"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:electron": "npm run dev --workspace electron",
    "build:client": "npm run build --workspace client",
    "build:electron": "npm run build --workspace electron",
    "migrate": "npm run migrate --workspace server",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "react-doctor": "^0.9.13"
  }
}
